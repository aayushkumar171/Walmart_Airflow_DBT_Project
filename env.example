# Apache Airflow
AIRFLOW_UID=50000

# Generate/use a Fernet key for your local Airflow environment.
# Do not commit the real key.
FERNET_KEY=<your-airflow-fernet-key>

# Databricks
DATABRICKS_HOST=<your-databricks-workspace-host>
DATABRICKS_TOKEN=<your-databricks-token>
DATABRICKS_HTTP_PATH=<your-databricks-sql-http-path>
DATABRICKS_JOB_ID=<your-databricks-job-id>

# AWS S3 - only if your local environment directly needs AWS credentials.
# Prefer IAM roles / instance profiles / secret managers where available.
AWS_ACCESS_KEY_ID=<your-aws-access-key>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-key>
AWS_REGION=<your-aws-region>
